{
  "name": "propsmart-realty---pune-real-estate-sales-partner",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "python3 scripts/generate_edge_seo_index.py && python3 scripts/generate_llms_txt.py && node scripts/generate-sitemap.mjs && vite build && cp dist/index.html dist/404.html",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives",
    "preview": "vite preview",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "index:now": "node scripts/submit-indexnow.mjs",
    "index:google": "node scripts/submit-google-indexing.mjs",
    "d1:setup": "bash scripts/cf_d1_setup.sh",
    "d1:sync:enterprise": "wrangler d1 execute propsmart-d1 --remote --file=migrations/0008_full_enterprise_catalog_sync.sql",
    "d1:migrate:local": "wrangler d1 execute propsmart-d1 --local --file=schema.sql",
    "d1:migrate:remote": "wrangler d1 execute propsmart-d1 --remote --file=schema.sql",
    "deploy:cf": "npm run build && wrangler pages deploy dist",
    "deploy": "vercel --prod"
  },
  "dependencies": {
    "@google/genai": "1.3.0",
    "@tanstack/react-query": "^5.90.20",
    "@types/leaflet": "^1.9.21",
    "@types/react-leaflet": "^2.8.3",
    "browser-image-compression": "^2.0.2",
    "clsx": "^2.1.1",
    "framer-motion": "^12.29.2",
    "leaflet": "^1.9.4",
    "lucide-react": "0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-hot-toast": "^2.6.0",
    "react-leaflet": "^4.2.1",
    "react-leaflet-cluster": "^4.0.0",
    "react-router-dom": "^7.13.0",
    "recharts": "2.13.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261114.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.14.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.23",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.0",
    "globals": "^17.3.0",
    "jsdom": "^27.4.0",
    "postcss": "^8.5.6",
    "sitemap": "^9.0.0",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.54.0",
    "vercel": "^50.10.0",
    "vite": "^6.4.3",
    "vitest": "^4.0.18",
    "wrangler": "^4.162.0"
  }
}
